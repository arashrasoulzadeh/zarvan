    r = min(r, digitSeg(q, vec2(-0.228, 0.165), vec2(-0.232, 0.253)));
    r = min(r, digitSeg(q, vec2(-0.232, 0.253), vec2(-0.209, 0.321)));
    r = min(r, digitSeg(q, vec2(-0.209, 0.321), vec2(-0.152, 0.382)));
    r = min(r, digitSeg(q, vec2(-0.152, 0.382), vec2(-0.084, 0.416)));
    r = min(r, digitSeg(q, vec2(-0.084, 0.416), vec2(-0.004, 0.428)));
    r = min(r, digitSeg(q, vec2(-0.004, 0.428), vec2(0.072, 0.42)));
    r = min(r, digitSeg(q, vec2(0.072, 0.42), vec2(0.144, 0.39)));
    r = min(r, digitSeg(q, vec2(0.144, 0.39), vec2(0.198, 0.34)));
    r = min(r, digitSeg(q, vec2(0.198, 0.34), vec2(0.228, 0.272)));
    r = min(r, digitSeg(q, vec2(0.228, 0.272), vec2(0.232, 0.192)));
    r = min(r, digitSeg(q, vec2(0.232, 0.192), vec2(0.221, 0.143)));
    r = min(r, digitSeg(q, vec2(0.221, 0.143), vec2(0.186, 0.086)));
    r = min(r, digitSeg(q, vec2(0.186, 0.086), vec2(0.087, -0.01)));
    r = min(r, digitSeg(q, vec2(0.084, -0.01), vec2(0.087, -0.01)));
  }
  else if (d == 9) {
    r = min(r, digitSeg(q, vec2(0.213, 0.03), vec2(0.232, -0.023)));
    r = min(r, digitSeg(q, vec2(0.232, -0.023), vec2(0.228, -0.198)));
    r = min(r, digitSeg(q, vec2(0.228, -0.198), vec2(0.209, -0.27)));
    r = min(r, digitSeg(q, vec2(0.209, -0.27), vec2(0.167, -0.342)));
    r = min(r, digitSeg(q, vec2(0.167, -0.342), vec2(0.114, -0.392)));
    r = min(r, digitSeg(q, vec2(0.114, -0.392), vec2(0.034, -0.422)));
    r = min(r, digitSeg(q, vec2(0.034, -0.422), vec2(-0.057, -0.418)));
    r = min(r, digitSeg(q, vec2(-0.057, -0.418), vec2(-0.129, -0.384)));
    r = min(r, digitSeg(q, vec2(-0.129, -0.384), vec2(-0.202, -0.297)));
    r = min(r, digitSeg(q, vec2(-0.202, -0.297), vec2(-0.232, -0.194)));
    r = min(r, digitSeg(q, vec2(-0.232, -0.194), vec2(-0.224, -0.068)));
    r = min(r, digitSeg(q, vec2(-0.224, -0.068), vec2(-0.175, 0.034)));
    r = min(r, digitSeg(q, vec2(-0.175, 0.034), vec2(-0.106, 0.087)));
    r = min(r, digitSeg(q, vec2(-0.106, 0.087), vec2(0.0, 0.103)));
    r = min(r, digitSeg(q, vec2(0.0, 0.103), vec2(0.046, 0.091)));
    r = min(r, digitSeg(q, vec2(0.046, 0.091), vec2(0.141, 0.038)));
    r = min(r, digitSeg(q, vec2(0.141, 0.038), vec2(0.213, 0.03)));
    r = min(r, digitSeg(q, vec2(0.213, 0.03), vec2(0.224, 0.057)));
    r = min(r, digitSeg(q, vec2(0.224, 0.057), vec2(0.217, 0.152)));
    r = min(r, digitSeg(q, vec2(0.217, 0.152), vec2(0.148, 0.293)));
    r = min(r, digitSeg(q, vec2(0.148, 0.293), vec2(0.095, 0.346)));
    r = min(r, digitSeg(q, vec2(0.095, 0.346), vec2(0.008, 0.395)));
    r = min(r, digitSeg(q, vec2(0.008, 0.395), vec2(-0.106, 0.418)));
    r = min(r, digitSeg(q, vec2(-0.106, 0.418), vec2(-0.11, 0.418)));
    r = min(r, digitSeg(q, vec2(-0.106, 0.418), vec2(-0.11, 0.422)));
    r = min(r, digitSeg(q, vec2(-0.183, 0.498), vec2(-0.11, 0.422)));
    r = min(r, digitSeg(q, vec2(-0.11, 0.418), vec2(-0.183, 0.346)));
    r = min(r, digitSeg(q, vec2(-0.11, 0.418), vec2(-0.11, 0.422)));
  }
  return r;
}

void main() {
  vec2 p = ((FlutterFragCoord().xy - uOrigin) / uSize - 0.5) * 2.0;
  float px = 2.0 / uSize.x; // one pixel in these units
  float state = uParams.x;
  bool current = state > 0.5 && state < 1.5;
  bool done = state >= 1.5;
  float r = length(p);

  float R = 0.34;
  vec2 p45 = vec2(p.x + p.y, p.y - p.x) * 0.70710678;
  float outer = min(box(p, R), box(p45, R));
  float inner = min(box(p, R * 0.64), box(p45, R * 0.64));
  float w = max(px * 1.4, current ? 0.026 : 0.018);

  float breathe = 0.5 + 0.5 * sin(uTime * 2.2);
  float fadeOut = 1.0 - smoothstep(0.6, 1.0, r); // nothing reaches the rect edge
  float halo = current ? exp(-max(outer, 0.0) * 7.0) * (0.35 + 0.35 * breathe) * fadeOut : 0.0;

  // Slow rays behind the current seal, turning.
  float rays = 0.0;
  if (current) {
    float ang = atan(p.y, p.x);
    float spin = uTime * 0.35;
    float ray = pow(max(0.0, cos((ang - spin) * 8.0)), 24.0);
    rays = ray * smoothstep(R * 0.9, R * 1.4, r) * (1.0 - smoothstep(0.55, 0.92, r)) * (0.5 + 0.4 * breathe);
  }

  // Sparks circling the current seal.
  float sparks = 0.0;
  if (current) {
    for (int i = 0; i < 3; i++) {
      float f = float(i);
      float a = uTime * 0.8 + f * 2.0944;
      vec2 c = vec2(cos(a), sin(a)) * (0.56 + 0.04 * sin(uTime * 2.0 + f));
      float tw = 0.5 + 0.5 * sin(uTime * 4.0 + f * 2.1);
      sparks += exp(-length(p - c) * 60.0) * tw;
    }
  }

  float body = 1.0 - smoothstep(-px, px, outer);
  vec3 col = mix(uCore.rgb, uArm.rgb, done || current ? 0.75 : 0.4);
  col = mix(col, uArm.rgb * 1.2, (1.0 - smoothstep(-px, px, inner)) * (current ? 0.6 : 0.3));
  float dim = current ? 1.0 : (done ? 0.9 : 0.62);

  float edge = 1.0 - smoothstep(0.0, w, abs(outer));
  float edge2 = 1.0 - smoothstep(0.0, w * 0.7, abs(inner));
  col = mix(col, uRim.rgb, clamp(edge + edge2 * 0.6, 0.0, 1.0) * dim);

  if (done) {
    // A brush tick: thin where the pen enters, thick where it presses.
    vec2 A = vec2(-0.14, 0.0);
    vec2 B = vec2(-0.05, 0.10);
    vec2 C = vec2(0.17, -0.12);
    vec2 s1 = seg(p, A, B);
    vec2 s2 = seg(p, B, C);
    float l1 = length(B - A);
    float l2 = length(C - B);
    float L = l1 + l2;
    float t1 = s1.y * l1 / L;
    float t2 = (l1 + s2.y * l2) / L;
    float w1 = 0.05 * (0.28 + 0.72 * pow(sin(3.14159 * t1), 0.7));
    float w2 = 0.05 * (0.28 + 0.72 * pow(sin(3.14159 * t2), 0.7));
    float tick = max(1.0 - smoothstep(w1 * 0.8, w1, s1.x), 1.0 - smoothstep(w2 * 0.8, w2, s2.x));
    col = mix(col, mix(uRim.rgb, vec3(1.0, 0.97, 0.88), 0.5), tick);
  }

  // The number, in the star's middle: cream strokes with a shimmer that sweeps
  // over them and a soft glow.
  float digitInk = 0.0;
  float digitGlow = 0.0;
  float num = uParams.y;
  if (num >= 0.0 && !done) {
    int n = int(num + 0.5);
    bool western = uParams.z > 0.5;
    float H = n >= 10 ? 0.29 : 0.37;
    float hw = 0.58 * (western ? DIGIT_STROKE_EN : DIGIT_STROKE_FA) * H;
    float dd = 1e9;
    if (n >= 10) {
      int tens = n / 10;
      int ones = n - tens * 10;
      float off = 0.3 * H;
      vec2 ql = (p - vec2(-off, 0.0)) / H;
      vec2 qr = (p - vec2(off, 0.0)) / H;
      dd = min(western ? digitDistEn(ql, tens) : digitDistFa(ql, tens),
               western ? digitDistEn(qr, ones) : digitDistFa(qr, ones)) * H;
    } else {
      vec2 q = p / H;
      dd = (western ? digitDistEn(q, n) : digitDistFa(q, n)) * H;
    }
    digitInk = 1.0 - smoothstep(hw - px, hw + px, dd);
    digitGlow = exp(-max(dd - hw, 0.0) * 16.0) * (current ? 0.5 : 0.18);
    vec3 inkCol = current ? vec3(1.0, 0.96, 0.82) : vec3(0.76, 0.9, 0.88);
    float shimmer = pow(max(0.0, sin((p.x - p.y) * 5.0 - uTime * (current ? 2.4 : 1.2))), 12.0);
    inkCol = mix(inkCol, uRim.rgb, shimmer * 0.7);
    col = mix(col, inkCol, digitInk * 0.95);
  }

  float bodyAlpha = body * (current || done ? 1.0 : 0.75);
  float glowA = max(halo, max(rays * 0.8, sparks * 0.8));
  float a = max(bodyAlpha, glowA);
  vec3 lit = col * bodyAlpha + uRim.rgb * (halo * 0.9 + rays * 0.7 + sparks) * (1.0 - body);
  lit += uRim.rgb * digitGlow * body;
  fragColor = vec4(min(lit, vec3(1.0)), a);
}
