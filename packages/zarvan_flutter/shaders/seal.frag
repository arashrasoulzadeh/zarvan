#include <flutter/runtime_effect.glsl>

// A small eight-pointed seal for a step of progress: a star of two squares,
// teal inside and edged with gold. Upcoming steps are dim, the current one is
// bright, breathes light, throws slow rays and has sparks circling it, and a
// done one carries a gold brush tick. The glow stays inside the rect (the
// star fills only its middle ~70%), so nothing is cut off at the edge. The
// number of an upcoming or current step is drawn on top by the game as text.
//
//   uOrigin - top-left of the rect, in pixels
//   uSize   - rect size, in pixels
//   uTime   - seconds (already multiplied by the effect's speed)
//   uPic    - unused (kept so every effect shares one uniform layout)
//   uRim    - gold
//   uArm    - teal
//   uCore   - the dark of the inner star
//   uParams - x: 0 upcoming, 1 current, 2 done; y: the number to show inside
//             (0..99, or -1 for none); z: 0 Persian digits, 1 Western
//
// The digits are drawn here, as the signed distance to outline data taken from a
// font's own digits (tool/gen_digits.py), so they need no text or image.

uniform vec2 uOrigin;
uniform vec2 uSize;
uniform float uTime;
uniform vec3 uPic;
uniform vec4 uRim;
uniform vec4 uArm;
uniform vec4 uCore;
uniform vec4 uParams;

out vec4 fragColor;

float box(vec2 p, float r) {
  return max(abs(p.x), abs(p.y)) - r;
}

vec2 seg(vec2 p, vec2 a, vec2 b) {
  vec2 pa = p - a;
  vec2 ba = b - a;
  float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
  return vec2(length(pa - ba * h), h);
}


// One edge of a digit's outline: the nearest distance so far, and the winding
// number of the outline around the point (non-zero means inside).
void digitEdge(vec2 p, vec2 a, vec2 b, inout float dm, inout int wn) {
  vec2 pa = p - a;
  vec2 ba = b - a;
  float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
  dm = min(dm, length(pa - ba * h));
  bool below = a.y <= p.y;
  bool belowB = b.y <= p.y;
  if (below != belowB) {
    float t = (p.y - a.y) / (b.y - a.y);
    if (a.x + t * (b.x - a.x) > p.x) {
      wn += belowB ? 1 : -1;
    }
  }
}

